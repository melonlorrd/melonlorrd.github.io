<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Mahaprasad · melonlorrd</title>
  <meta name="description" content="Mahaprasad's corner of the internet. Writing about Infrastructure and Systems Engineering.">
  <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121614" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Mahaprasad · melonlorrd">
  <meta property="og:description" content="Writing about Infrastructure and Systems Engineering.">
  <meta property="og:url" content="https://melonlorrd.github.io/">
  <meta property="og:image" content="https://melonlorrd.github.io/favicon.png">
  <link rel="canonical" href="https://melonlorrd.github.io/">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="icon" type="image/png" sizes="512x512" href="favicon.png">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="Melonlorrd's Blog" href="/rss.xml">
  <link rel="stylesheet" href="style.css?v={{ .CSSVersion }}">
</head>

<body>
  <main class="wrap">
    <header class="intro">
      <a class="avatar" href="index.html" aria-label="melonlorrd"><img src="favicon.svg" alt="" width="56" height="56"></a>

      <h1>Hello, I'm Mahaprasad.</h1>
      <p>Passionate about Infrastructure and Systems Engineering. Currently working as a Site Reliability Engineer at Juspay. In the quiet hours, I enjoy Music and Sketching.</p>

      <ul class="links">
        <li><a href="https://github.com/melonlorrd" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/mprasadme" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </header>

    <section class="writing" aria-label="Writing">
      {{ range .Years }}
      <h2 class="section-label">{{ .Year }}</h2>
      <ul class="posts">
        {{ range .Blogs }}
        <li>
          <a href="{{ .Slug }}.html">
            <span class="t">{{ .Title }}</span>
            <span class="m"><time datetime="{{ .Date.Format "2006-01-02" }}">{{ .Date.Format "Jan 2" }}</time> · {{ .ReadingTime }} min</span>
          </a>
        </li>
        {{ end }}
      </ul>
      {{ end }}
    </section>

    <footer class="foot">
      <p>built with Go, Markdown &amp; questionable decisions</p>
      <p>last built {{ .BuildDate }} from {{ .BuildTZ }}</p>
    </footer>
  </main>
</body>
</html>
